# Banco remoto no Turso:
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=
#
# Sem essas variáveis, a aplicação usa um arquivo local do libSQL
# (o mesmo motor do Turso) em data/financeiro.db.
TURSO_DATABASE_URL=file:./data/financeiro.db
TURSO_AUTH_TOKEN=

# Segredo para assinar a sessão. Troque por um valor longo e aleatório.
AUTH_SECRET=

# Única conta com acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
